# Copy this file to .env and fill in the real values.
# Never commit the real .env file.

# PostgreSQL connection string (Azure Database for PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/herdtrack?sslmode=require"

# Secret used to sign login tokens (JWT). Use a long random string.
JWT_SECRET="change-me"

# Port for the Express API
PORT=3000
